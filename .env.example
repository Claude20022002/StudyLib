APP_NAME=StudyLib
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=studylib
DB_USERNAME=studylib
DB_PASSWORD=secret

# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Derrière la passerelle de la plateforme (StudyLib sous /biblio, même origine que Planner) :
#   APP_URL=https://planner.hestim.ma/biblio   ASSET_URL=/biblio
#   SESSION_PATH=/biblio   SESSION_COOKIE=studylib_session   SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@hestim.ma"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_REGION=us-east-1
MINIO_BUCKET=studylib
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_URL=

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey

CLAUDE_API_KEY=
YOUTUBE_API_KEY=

FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=8900
FORWARD_MEILISEARCH_PORT=7700

VITE_APP_NAME="${APP_NAME}"

# ── Connexion unique avec HESTIM Planner (config/planner.php) ──────────────────
# Adresse interne de l'API Planner (réseau Docker) ; le JWKS en est déduit
PLANNER_API_URL=http://backend:5000/api
# Page de connexion de Planner (même origine)
PLANNER_LOGIN_URL=/connexion
# Jeton de service de la synchronisation des filières et modules (= INTEGRATION_TOKEN de Planner)
PLANNER_INTEGRATION_TOKEN=

# ── Import Google Drive (php artisan studylib:import-drive {folderId}) ─────────
# Clé JSON d'un compte de service, hors Git (storage/app/private est ignoré par Git et Docker) ;
# partager le dossier Drive en Lecteur avec son adresse client_email
GOOGLE_DRIVE_CREDENTIALS=
# Dossier importé par défaut : fin de l'URL drive.google.com/drive/folders/<ID> (pas le client_id numérique)
GOOGLE_DRIVE_FOLDER_ID=
# Filière des documents quand le Drive ne la précise pas (ex. IIIA) ; évite les homonymes d'autres filières
GOOGLE_DRIVE_FILIERE=
